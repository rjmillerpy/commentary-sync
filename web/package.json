{
  "name": "commentary-sync-studio",
  "version": "0.1.0",
  "private": true,
  "description": "The broadcaster studio: sign in, pick a game, check the mic, go live.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint --max-warnings 0 .",
