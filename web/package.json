    "test": "jest --coverage",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@commentary-sync/client": "0.1.0",
    "livekit-client": "2.22.3",
    "next": "15.5.27",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.27",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "typescript": "5.9.3"
  }
